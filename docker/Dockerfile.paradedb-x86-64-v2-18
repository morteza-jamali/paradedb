# Build ParadeDB from source for amd64 CPUs without AVX/AVX2 (x86-64-v2).
#
# Always produces a linux/amd64 image with pg_search compiled for x86-64-v2,
# even when docker build runs on arm64 or other architectures (via buildx/QEMU).
#
# RESOURCE RECOMMENDATIONS:
# - Minimum 8GB memory for the build (Rust LTO is memory-heavy)
# - Minimum 4 CPU cores recommended
#
# Build from the repository root:
#   docker buildx build --platform linux/amd64 \
#     -f docker/Dockerfile.paradedb-build \
#     -t paradedb:no-avx \
#     --load .
#
# Run:
#   docker run --name paradedb \
#     -e POSTGRES_USER=myuser \
#     -e POSTGRES_PASSWORD=mypassword \
#     -e POSTGRES_DB=mydatabase \
#     -v paradedb_data:/var/lib/postgresql/ \
#     -p 5432:5432 \
#     -d paradedb:no-avx

# syntax=docker/dockerfile:1

ARG PG_VERSION_MAJOR=18
ARG RUST_VERSION=1.96
ARG PGRX_VERSION=0.18.1

FROM --platform=linux/amd64 rust:${RUST_VERSION}-slim-trixie AS builder

ARG PG_VERSION_MAJOR
ARG PGRX_VERSION

# Always compile for the x86-64-v2 microarchitecture level (no AVX/AVX2).
ENV RUSTFLAGS="-C target-cpu=x86-64-v2"

SHELL ["/bin/bash", "-o", "pipefail", "-c", "-e"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    gnupg \
    libclang-dev \
    libssl-dev \
    pkg-config \
    && install -d -m 0755 /usr/share/keyrings \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --dearmor -o /usr/share/keyrings/postgresql.gpg.asc \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql.gpg.asc] http://apt.postgresql.org/pub/repos/apt trixie-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-${PG_VERSION_MAJOR} \
        postgresql-server-dev-${PG_VERSION_MAJOR} \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

RUN PG_CONFIG="/usr/lib/postgresql/${PG_VERSION_MAJOR}/bin/pg_config" && \
    cargo install --locked cargo-pgrx --version "${PGRX_VERSION}" && \
    cd pg_search && \
    cargo pgrx init --pg${PG_VERSION_MAJOR}="${PG_CONFIG}" && \
    cargo pgrx package --package pg_search \
        --pg-config "${PG_CONFIG}" \
        --features "pg${PG_VERSION_MAJOR}" \
        --no-default-features

FROM --platform=linux/amd64 postgres:${PG_VERSION_MAJOR}-trixie AS paradedb

ARG PG_VERSION_MAJOR

LABEL maintainer="ParadeDB - https://paradedb.com" \
    org.opencontainers.image.description="ParadeDB built from source for amd64 CPUs without AVX/AVX2 (x86-64-v2)" \
    org.opencontainers.image.source="https://github.com/paradedb/paradedb"

SHELL ["/bin/bash", "-o", "pipefail", "-c", "-e"]

COPY --from=builder \
    /build/pg_search/target/release/pg_search-pg${PG_VERSION_MAJOR}/usr/ \
    /usr/

# Install Barman Cloud and its dependencies for Azure, Google, and AWS via `pip`, and clean up after the installation to
# minimize the size of the image. These are required for enabling Postgres backups in our CloudNativePG deployments.
RUN apt-get update && \
    apt-get install -y --no-install-recommends libpq5 python3-pip python3-dev python3-psycopg2 && \
    rm /usr/lib/python*/EXTERNALLY-MANAGED && \
    pip3 install --no-cache-dir 'setuptools==82.0.1' 'barman[cloud,azure,snappy,google]==3.18.0' && \
    apt-get remove -y python3-dev python3-pip --purge && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/* && \
    find /usr/lib | grep -E "(/__pycache__$|\.pyc$|\.pyo$)" | xargs rm -rf && \
    find /usr/local | grep -E "(/__pycache__$|\.pyc$|\.pyo$)" | xargs rm -rf && \
    find /var/cache -type f -exec truncate --size 0 {} \; && \
    find /var/log -type f -exec truncate --size 0 {} \;

# Install core extensions
# Use the PGDG archive so these pinned extension versions remain available after newer
# versions replace them in the live Debian and PGDG apt repositories.
ENV POSTGIS_VERSION_MAJOR=3
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && echo "deb [ signed-by=/usr/local/share/keyrings/postgres.gpg.asc ] https://apt-archive.postgresql.org/pub/repos/apt trixie-pgdg-archive main" > /etc/apt/sources.list.d/pgdg-archive.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    postgresql-${PG_VERSION_MAJOR}-pgvector=0.8.2-1.pgdg13+1 \
    postgresql-${PG_VERSION_MAJOR}-cron=1.6.7-2.pgdg13+1 \
    postgresql-${PG_VERSION_MAJOR}-pg-ivm=1.13-1.pgdg13+1 \
    postgresql-${PG_VERSION_MAJOR}-postgis-$POSTGIS_VERSION_MAJOR \
    postgresql-${PG_VERSION_MAJOR}-postgis-$POSTGIS_VERSION_MAJOR-scripts \
    && rm /etc/apt/sources.list.d/pgdg-archive.list \
    && rm -rf /var/lib/apt/lists/* && \
    update-ca-certificates

# The postgresql.conf.sample file is used as a template for the postgresql.conf file, which
# does not exist until the first time the container is started. By adding our settings to the
# postgresql.conf.sample file, we ensure that our settings are applied onto the postgresql.conf file.
#
# The `postgres` database is the default database that exists in every Postgres installation. The pg_cron
# extension requires a database to store its metadata tables. By using `postgres`, we ensure that it has a
# stable, always-available database for its operations, no matter what other databases are created or deleted.
RUN sed -i "s/^#shared_preload_libraries = ''/shared_preload_libraries = 'pg_search,pg_cron,pg_stat_statements'/" /usr/share/postgresql/postgresql.conf.sample && \
    grep "shared_preload_libraries = 'pg_search,pg_cron,pg_stat_statements'" /usr/share/postgresql/postgresql.conf.sample && \
    echo "cron.database_name = 'postgres'" >> /usr/share/postgresql/postgresql.conf.sample && \
    echo "pg_stat_statements.track = 'top'" >> /usr/share/postgresql/postgresql.conf.sample

WORKDIR /

COPY docker/bootstrap.sh /docker-entrypoint-initdb.d/10_bootstrap_paradedb.sh
